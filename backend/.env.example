# Server
PORT=4000
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:4000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAIL=
GOOGLE_REFRESH_TOKEN=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage: empty = local disk, "supabase" = cloud storage
STORAGE=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Max upload file size in MB (default 15)
MAX_UPLOAD_MB=15

# Package tracking workflow
SIM_API_KEY=
SIM_WORKFLOW_URL=

# Rate limiting (relaxed for local dev; keep tight in production)
RATE_LIMIT_API_MAX=2000
RATE_LIMIT_API_WINDOW_MIN=15
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# Logging
LOG_LEVEL=info

# Seed script (node seed.js) — admin user
# If ADMIN_PASSWORD is empty, seeding skips admin creation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
